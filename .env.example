# InsightLoop Environment Configuration Template

# ----------------- BACKEND CONFIGURATION -----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/insightloop
JWT_SECRET=insightloop_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRES_IN=7d

# QR code public URL. Leave empty to auto-detect the reachable LAN IP
# (virtual adapters such as Hyper-V/VMware/WSL are ignored).
# Set this to the URL phones should open, e.g. https://insightloop.yourdomain.com
QR_BASE_URL=

# Plain-HTTP dev server. Used for the localUrl in the QR payload - open in
# this machine's own browser, where http://localhost is already secure.
QR_PORT=5173

# HTTPS dev server. QR codes and shared links point here, because browsers
# only expose the microphone (speech-to-text) on secure contexts and
# http://<LAN-IP> is not one. Accept the self-signed certificate warning once.
QR_HTTPS_PORT=5174

# Bhashini API Configuration (Optional - graceful local fallback enabled when absent)
# Get credentials: https://dashboard.bhashini.co.in/user/register  (see README "Bhashini")
#   BHASHINI_USER_ID        -> shown under My Profile after DIBD approval
#   BHASHINI_API_KEY        -> ULCA API key from My Profile -> API Keys
#   BHASHINI_INFERENCE_API_KEY -> "Generate Inference API Key" (used in Authorization);
#                                 optional - falls back to BHASHINI_API_KEY if blank
#   BHASHINI_ASR_SERVICE_ID -> optional, pins an ASR model; blank = pipeline default
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_ASR_SERVICE_ID=
BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# ----------------- FRONTEND CONFIGURATION -----------------
# Use the relative /api path so any device (including phones scanning the QR)
# reaches the backend through the Vite dev proxy / your reverse proxy.
VITE_API_URL=/api
VITE_APP_NAME=InsightLoop

# HTTPS dev-server port. Visiting the plain-HTTP server over a LAN IP
# (http://<ip>:5173) redirects here so speech-to-text works on every device.
VITE_HTTPS_PORT=5174

# ----------------- AI SERVICE CONFIGURATION -----------------
AI_PORT=8000
QDRANT_HOST=localhost
QDRANT_PORT=6333
